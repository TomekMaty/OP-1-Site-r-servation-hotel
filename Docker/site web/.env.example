# ============================================================
# Copier ce fichier en .env et remplir les valeurs ci-dessous
# Le fichier .env ne doit JAMAIS être commité sur Git
# ============================================================

# --- Base de données MySQL ---
MYSQL_ROOT_PASSWORD=changeme_root
MYSQL_USER=saclay_user
MYSQL_PASSWORD=changeme_password

# --- JWT (authentification API) ---
# Générer avec : openssl rand -hex 32
JWT_SECRET=changeme_jwt_secret_very_long_and_random

# --- Mot de passe administrateur ---
ADMIN_PASSWORD=changeme_admin_password

# --- Telegram (notifications commandes room service) ---
# Créer un bot via @BotFather sur Telegram pour obtenir le token
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
